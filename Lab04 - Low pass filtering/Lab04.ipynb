    "# ----------------------------------\n",
    "# Função: filtro de média manual\n",
    "# ----------------------------------\n",
    "def mean_filter(img, k):\n",
    "    h, w = img.shape\n",
    "    pad = k // 2\n",
    "\n",
    "    # padding manual (replicação de borda)\n",
    "    padded = np.zeros((h + 2*pad, w + 2*pad), dtype=np.float32)\n",
    "    padded[pad:pad+h, pad:pad+w] = img\n",
    "\n",
    "    # replica bordas\n",
    "    padded[:pad, pad:pad+w] = img[0, :]\n",
    "    padded[pad+h:, pad:pad+w] = img[-1, :]\n",
    "    padded[:, :pad] = padded[:, pad:pad+1]\n",
    "    padded[:, pad+w:] = padded[:, pad+w-1:pad+w]\n",
    "\n",
    "    out = np.zeros((h, w), dtype=np.float32)\n",
    "\n",
    "    for i in range(h):\n",
    "        for j in range(w):\n",
    "            soma = 0.0\n",
    "            for u in range(k):\n",
    "                for v in range(k):\n",
    "                    soma += padded[i+u, j+v]\n",
    "            out[i, j] = soma / (k * k)\n",
    "\n",
    "    return out.astype(np.uint8)\n",
    " \n",
    "\n",
    "\n",
    "# ----------------------------------\n",
    "# Leitura da imagem\n",
    "# ----------------------------------\n",
    "img = cv2.imread(\"sta2.png\", cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "# ----------------------------------\n",
    "# 3x3\n",
    "# ----------------------------------\n",
    "mean_3x3 = mean_filter(img, 3)\n",
    "\n",
    "# ----------------------------------\n",
    "# 7x7\n",
    "# ----------------------------------\n",
    "mean_7x7 = mean_filter(img, 7)\n",
    "\n",
    "# ----------------------------------\n",
    "# 3x3 aplicado 3 vezes\n",
    "# ----------------------------------\n",
    "mean_3x3_3x = mean_filter(img, 3)\n",
    "mean_3x3_3x = mean_filter(mean_3x3_3x, 3)\n",
    "mean_3x3_3x = mean_filter(mean_3x3_3x, 3)\n",
    "\n",
    "# ----------------------------------\n",
