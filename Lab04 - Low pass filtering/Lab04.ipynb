<<<<<<< HEAD
    "plt.imshow(img2, cmap='gray', vmin=0, vmax=255);\n",
    "import math\n",
    "# -------------------------------------------------\n",
    "# Kernel Gaussiano 2D\n",
    "# -------------------------------------------------\n",
    "def gaussian_kernel(k, sigma):\n",
    "    pad = k // 2\n",
    "    kernel = np.zeros((k, k), dtype=np.float32)\n",
    "\n",
    "    for i in range(-pad, pad + 1):\n",
    "        for j in range(-pad, pad + 1):\n",
    "            kernel[i + pad, j + pad] = math.exp(-(i*i + j*j) / (2 * sigma * sigma))\n",
    "\n",
    "    kernel /= kernel.sum()\n",
    "    return kernel\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Convolução manual\n",
    "# -------------------------------------------------\n",
    "def apply_filter(img, kernel):\n",
    "    h, w = img.shape\n",
    "    k = kernel.shape[0]\n",
    "    pad = k // 2\n",
    "\n",
    "    padded = np.zeros((h + 2*pad, w + 2*pad), dtype=np.float32)\n",
    "    padded[pad:pad+h, pad:pad+w] = img\n",
    "\n",
    "    # replicação de borda\n",
    "    padded[:pad, pad:pad+w] = img[0, :]\n",
    "    padded[pad+h:, pad:pad+w] = img[-1, :]\n",
    "    padded[:, :pad] = padded[:, pad:pad+1]\n",
    "    padded[:, pad+w:] = padded[:, pad+w-1:pad+w]\n",
    "\n",
    "    out = np.zeros((h, w), dtype=np.float32)\n",
    "\n",
    "    for i in range(h):\n",
    "        for j in range(w):\n",
    "            soma = 0.0\n",
    "            for u in range(k):\n",
    "                for v in range(k):\n",
    "                    soma += padded[i+u, j+v] * kernel[u, v]\n",
    "            out[i, j] = soma\n",
    "\n",
    "    return out.astype(np.uint8)\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Leitura da imagem\n",
    "# -------------------------------------------------\n",
    "img = cv2.imread(\"ben2.png\", cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Aplicações pedidas\n",
    "# -------------------------------------------------\n",
    "g1 = apply_filter(img, gaussian_kernel(5, 1.0))\n",
    "g2 = apply_filter(img, gaussian_kernel(9, 2.0))\n",
    "g3 = apply_filter(img, gaussian_kernel(15, 4.0))\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Visualização\n",
    "# -------------------------------------------------\n",
    "plt.figure(figsize=(10,8))\n",
    "\n",
    "plt.subplot(2,2,1)\n",
    "plt.imshow(img, cmap='gray', vmin=0, vmax=255)\n",
    "plt.title(\"Original\")\n",
    "plt.axis('off')\n",
    "\n",
    "plt.subplot(2,2,2)\n",
