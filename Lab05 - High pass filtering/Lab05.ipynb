    "                    [-1, 0, 1]], dtype=np.float32)\n",
    "\n",
    "sobel_y = np.array([[-1, -2, -1],\n",
    "                    [ 0,  0,  0],\n",
    "                    [ 1,  2,  1]], dtype=np.float32)\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Aplicação Sobel\n",
    "# -------------------------------------------------\n",
