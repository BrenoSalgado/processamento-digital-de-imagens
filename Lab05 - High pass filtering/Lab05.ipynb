    "# -------------------------------------------------\n",
    "# Convolução manual genérica\n",
    "# -------------------------------------------------\n",
    "def conv2d(img, kernel):\n",
    "    h, w = img.shape\n",
    "    k = kernel.shape[0]\n",
    "    pad = k // 2\n",
    "\n",
    "    padded = np.zeros((h + 2*pad, w + 2*pad), dtype=np.float32)\n",
    "    padded[pad:pad+h, pad:pad+w] = img\n",
    "\n",
    "    # replicação de borda\n",
    "    padded[:pad, pad:pad+w] = img[0, :]\n",
    "    padded[pad+h:, pad:pad+w] = img[-1, :]\n",
    "    padded[:, :pad] = padded[:, pad:pad+1]\n",
    "    padded[:, pad+w:] = padded[:, pad+w-1:pad+w]\n",
    "\n",
    "    out = np.zeros((h, w), dtype=np.float32)\n",
    "\n",
    "    for i in range(h):\n",
    "        for j in range(w):\n",
    "            soma = 0.0\n",
    "            for u in range(k):\n",
    "                for v in range(k):\n",
    "                    soma += padded[i+u, j+v] * kernel[u, v]\n",
    "            out[i, j] = soma\n",
    "\n",
    "    return out\n",
    "\n",
    "# -------------------------------------------------\n",
    "# Leitura da imagem\n",
    "# -------------------------------------------------\n",
    "img = cv2.imread(\"cln1.png\", cv2.IMREAD_GRAYSCALE).astype(np.float32)\n",
