    "matriz = (img > 137).astype(np.uint8)\n",
    "kernel = np.ones((3,3), np.uint8)\n",
    "matriz_limpa = cv2.morphologyEx(matriz, cv2.MORPH_OPEN, kernel)\n",
    " \n",
    "print(\"Objetos contados = \", conta_objeto(matriz_limpa))"
