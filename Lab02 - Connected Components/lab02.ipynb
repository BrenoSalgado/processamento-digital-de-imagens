    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    " \n",
    "def conta_objeto(matriz):\n",
    "    linhas, colunas = matriz.shape\n",
    "    visitados = np.zeros_like(matriz)\n",
    "    objeto = 0\n",
    " \n",
    "    def dfs(i, j):\n",
    "        if i < 0 or i >= linhas or j < 0 or j >= colunas:\n",
    "            return\n",
    "        if matriz[i, j] == 0 or visitados[i, j] == 1:\n",
    "            return\n",
    "        visitados[i, j] = 1\n",
    "        dfs(i-1, j)\n",
    "        dfs(i+1, j)\n",
    "        dfs(i, j - 1)\n",
    "        dfs(i, j + 1)\n",
    " \n",
    "    for i in range(linhas):\n",
    "        for j in range(colunas):\n",
    "            if matriz[i, j] == 1 and visitados[i, j] == 0:\n",
    "                objeto += 1\n",
    "                dfs(i, j)\n",
    "    return objeto\n",
    " \n",
