    "import numpy as np\n",
    "import math\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# inicialização\n",
    "dist = np.zeros((h, w), dtype=np.float32)\n",
    "\n",
    "INF = 1e9\n",
    "\n",
    "for i in range(h):\n",
    "    for j in range(w):\n",
    "        if bin_img[i, j] == 1:\n",
    "            dist[i, j] = INF\n",
    "        else:\n",
    "            dist[i, j] = 0\n",
    "\n",
    "# -----------------------------\n",
    "# Primeira passada (top-left → bottom-right)\n",
    "# -----------------------------\n",
    "for i in range(h):\n",
    "    for j in range(w):\n",
    "        if dist[i, j] != 0:\n",
    "            min_val = dist[i, j]\n",
    "\n",
    "            if i > 0:\n",
    "                min_val = min(min_val, dist[i-1, j] + 1)\n",
    "            if j > 0:\n",
    "                min_val = min(min_val, dist[i, j-1] + 1)\n",
    "            if i > 0 and j > 0:\n",
    "                min_val = min(min_val, dist[i-1, j-1] + math.sqrt(2))\n",
    "            if i > 0 and j < w-1:\n",
    "                min_val = min(min_val, dist[i-1, j+1] + math.sqrt(2))\n",
    "\n",
    "            dist[i, j] = min_val\n",
    "\n",
    "# -----------------------------\n",
    "# Segunda passada (bottom-right → top-left)\n",
    "# -----------------------------\n",
    "for i in range(h-1, -1, -1):\n",
    "    for j in range(w-1, -1, -1):\n",
    "        if dist[i, j] != 0:\n",
    "            min_val = dist[i, j]\n",
    "\n",
    "            if i < h-1:\n",
    "                min_val = min(min_val, dist[i+1, j] + 1)\n",
    "            if j < w-1:\n",
    "                min_val = min(min_val, dist[i, j+1] + 1)\n",
    "            if i < h-1 and j < w-1:\n",
    "                min_val = min(min_val, dist[i+1, j+1] + math.sqrt(2))\n",
    "            if i < h-1 and j > 0:\n",
    "                min_val = min(min_val, dist[i+1, j-1] + math.sqrt(2))\n",
    "\n",
    "            dist[i, j] = min_val\n",
    "\n",
    "# visualização\n",
    "plt.figure(figsize=(5,5))\n",
    "plt.imshow(dist, cmap='jet')\n",
    "plt.colorbar(label='Distância')\n",
    "plt.title(\"Transformada Distância (2-pass, analógica)\")\n",
    "plt.axis('off')\n",
    "plt.show()\n"
