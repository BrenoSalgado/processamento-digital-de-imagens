    "# code here\n",
    "\n",
    "# -----------------------------\n",
    "# leitura\n",
    "# -----------------------------\n",
    "img = cv2.imread('pout.tif', cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "# -----------------------------\n",
    "# histograma original\n",
    "# -----------------------------\n",
    "hist = np.zeros(256)\n",
    "\n",
    "for i in range(img.shape[0]):\n",
    "    for j in range(img.shape[1]):\n",
    "        hist[img[i, j]] += 1\n",
    "\n",
    "# -----------------------------\n",
    "# equalização usando OpenCV\n",
    "# -----------------------------\n",
    "eq = cv2.equalizeHist(img)\n",
    "\n",
    "# histograma equalizado\n",
    "hist_eq = np.zeros(256)\n",
    "\n",
    "for i in range(eq.shape[0]):\n",
    "    for j in range(eq.shape[1]):\n",
    "        hist_eq[eq[i, j]] += 1\n",
    "\n",
    "# -----------------------------\n",
    "# curva de transformação\n",
    "# -----------------------------\n",
    "cdf = hist.cumsum()\n",
    "cdf_norm = (cdf - cdf.min()) * 255 / (cdf.max() - cdf.min())\n",
    "\n",
    "# -----------------------------\n",
    "# visualização\n",
    "# -----------------------------\n",
    "plt.figure(figsize=(12,4))\n",
    "\n",
    "plt.subplot(1,3,1)\n",
    "plt.plot(hist)\n",
    "plt.title('Histograma original')\n",
    "\n",
    "plt.subplot(1,3,2)\n",
    "plt.plot(hist_eq)\n",
    "plt.title('Histograma equalizado')\n",
