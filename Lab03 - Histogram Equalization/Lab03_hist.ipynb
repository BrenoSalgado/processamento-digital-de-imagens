    "# code here\n",
    "\n",
    "import numpy as np\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "\n",
    "# -----------------------------\n",
    "# leitura da imagem\n",
    "# -----------------------------\n",
    "img = cv2.imread('im_cells.png', cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "h, w = img.shape\n",
    "L = 256  # níveis de cinza\n",
    "\n",
    "# -----------------------------\n",
    "# negativo manual\n",
    "# s = L - 1 - r\n",
    "# -----------------------------\n",
    "neg = np.zeros((h, w), dtype=np.uint8)\n",
    "\n",
    "for i in range(h):\n",
    "    for j in range(w):\n",
    "        neg[i, j] = (L - 1) - img[i, j]\n",
    "\n",
    "# -----------------------------\n",
    "# recuperar a imagem original a partir do negativo\n",
    "# -----------------------------\n",
    "rec = np.zeros((h, w), dtype=np.uint8)\n",
    "\n",
    "for i in range(h):\n",
    "    for j in range(w):\n",
    "        rec[i, j] = (L - 1) - neg[i, j]\n",
    "\n",
    "# -----------------------------\n",
    "# transformação logarítmica\n",
    "# s = c * log(1 + r)\n",
    "# -----------------------------\n",
    "log_img = np.zeros((h, w), dtype=np.float32)\n",
    "\n",
    "c = (L - 1) / math.log(1 + np.max(img))\n",
    "\n",
    "for i in range(h):\n",
    "    for j in range(w):\n",
    "        log_img[i, j] = c * math.log(1 + img[i, j])\n",
    "\n",
    "log_img = log_img.astype(np.uint8)\n",
    "\n",
    "# -----------------------------\n",
    "# visualização\n",
    "# -----------------------------\n",
    "plt.figure(figsize=(10,4))\n",
    "\n",
    "plt.subplot(1,3,1)\n",
    "plt.imshow(img, cmap='gray')\n",
    "plt.title('Original')\n",
    "plt.axis('off')\n",
    "\n",
    "plt.subplot(1,3,2)\n",
    "plt.imshow(neg, cmap='gray')\n",
    "plt.title('Negativa')\n",
    "plt.axis('off')\n",
    "\n",
    "plt.subplot(1,3,3)\n",
    "plt.imshow(log_img, cmap='gray')\n",
    "plt.title('Logarítmica')\n",
    "plt.axis('off')\n",
    "\n",
    "plt.show()\n"
